# Copie para %USERPROFILE%\.config\google-ads-mcp\.env e preencha.
# Este arquivo fica FORA de qualquer repositório. Nunca faça commit do .env.

# Gerado por gerar_credencial.py (não edite o conteúdo do arquivo)
GOOGLE_APPLICATION_CREDENTIALS=~/.config/google-ads-mcp/adc.json

# ID do projeto no Google Cloud onde a Google Ads API está ativada
GOOGLE_PROJECT_ID=COLE_AQUI_O_ID_DO_PROJETO

# OPCIONAL. Desde 2026 o acesso da Google Ads API e gerenciado no projeto do Google Cloud
# (Console > APIs > Google Ads API > Access levels > pedir Explorer). Deixe como esta, a menos
# que voce ja tenha um developer token antigo da Central de API.
GOOGLE_ADS_DEVELOPER_TOKEN=COLE_AQUI_O_DEVELOPER_TOKEN

# ID da MCC, só números (sem traço). Opcional, mas evita passar em toda consulta.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
